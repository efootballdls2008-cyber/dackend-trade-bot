# Server
PORT=3001
NODE_ENV=development

# CORS - comma-separated origins for production, or * for all
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# JWT
JWT_SECRET=3d2a82c636a657f17e9b808e571ac8b125a8fd3fe220b59bf7f4dc024b840e79154239481baf239e80076849d910a408967fd865c9d3afb8af675456515da1d4
JWT_EXPIRES_IN=7d

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=schwab_db
DB_USER=schwab_user
DB_PASSWORD=schwab_pass
DB_ROOT_PASSWORD=rootpassword

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=100

# Email Configuration (Resend)
EMAIL_ENABLED=false
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Charles Schwab Trading Platform
ADMIN_EMAIL=paxfulexchangecompany@gmail.com

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Default Admin Account (seeded on first startup ONLY if no admin exists yet)
# ADMIN_SEED_PASSWORD is REQUIRED — the server will refuse to start in production
# if this is not set or is a known weak value. Choose a strong password (16+ chars).
ADMIN_SEED_EMAIL=paxfulexchangecompany@gmail.com
ADMIN_SEED_PASSWORD=paxfulexchangecompany
ADMIN_SEED_FIRST_NAME=Charles
ADMIN_SEED_LAST_NAME=Schwab
