# ═══════════════════════════════════════════════════════════════
# Backend Production Environment Configuration
# Charles Schwab Trading Platform
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────
NODE_ENV=production

# ─────────────────────────────────────────────────────────────
# CORS Configuration
# Comma-separated list of allowed origins
# ─────────────────────────────────────────────────────────────
CORS_ORIGIN=https://charlesschwabsoq.vercel.app,https://schwabadminsoq.vercel.app

# ─────────────────────────────────────────────────────────────
# JWT Configuration
# ⚠️ CHANGE IN PRODUCTION - Use a strong random secret
# ─────────────────────────────────────────────────────────────
JWT_SECRET=U5QRKD8DyNWtlPBbHwXD6ruZs0WEU4/7Z1XBsPbk7V4=
JWT_EXPIRES_IN=7d


# Public Railway URL
# ─────────────────────────────────────────────────────────────
RAILWAY_URL=https://soq-dackend-trade-bot-production.up.railway.app


# ─────────────────────────────────────────────────────────────
# Database — use Railway reference variables on the platform
# These are resolved by Railway from the linked MySQL service
# ─────────────────────────────────────────────────────────────

DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# ─────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=90000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20

# ─────────────────────────────────────────────────────────────
# Email Configuration (Gmail SMTP)
# ⚠️ REQUIRED: Generate Gmail App Password
# Instructions: See GMAIL-SMTP-SETUP.md
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password below (NOT your regular password)
# ─────────────────────────────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=scchwabinvestments@gmail.com
EMAIL_PASS=gekopsphfoirfqhi
EMAIL_FROM=scchwabinvestments@gmail.com
EMAIL_FROM_NAME=Charles Schwab Trading Platform
ADMIN_EMAIL=scchwabinvestments@gmail.com



# ─────────────────────────────────────────────────────────────
# Frontend URL (for email links and CORS)
# ─────────────────────────────────────────────────────────────
FRONTEND_URL=https://charlesschwabsoq.vercel.app

# ─────────────────────────────────────────────────────────────
# Default Admin Account
# Seeded on first startup ONLY if no admin exists
# ⚠️ CHANGE ADMIN_SEED_PASSWORD before deploying
# ─────────────────────────────────────────────────────────────
ADMIN_SEED_EMAIL=larryrobert0742@gmail.com
ADMIN_SEED_PASSWORD=Password@123!
ADMIN_SEED_FIRST_NAME=Larry
ADMIN_SEED_LAST_NAME=Robert